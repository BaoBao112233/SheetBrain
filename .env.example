# SheetBrain Environment Configuration Example
# Copy this file to .env and fill in your values

# Google Cloud Vertex AI Configuration
GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json
GOOGLE_PROJECT_ID=your-project-id-here
GOOGLE_LOCATION=us-central1
GOOGLE_MODEL_NAME=gemini-2.0-flash-exp

# Processing Configuration
MAX_TURNS=3
TOKEN_BUDGET=10000
LANGUAGE=English  # Options: English, Vietnamese, Chinese, Japanese, Korean, Spanish, French, German

# Features
ENABLE_VALIDATION=true
ENABLE_UNDERSTANDING=true

# Timeouts and Retries
MAX_RETRIES=3
TIMEOUT=30

# API Rate Limiting
# Delay in seconds after each successful API call to respect rate limits
# For 5-10 RPM quota: use 10 seconds (6 requests/minute)
# For 60 RPM quota: use 1-2 seconds
API_RATE_LIMIT_DELAY=10
